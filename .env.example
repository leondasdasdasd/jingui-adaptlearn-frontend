# Development proxy targets. These values are read by Vite on the developer machine.
BFF_PROXY_TARGET=http://127.0.0.1:8787
CLASSROOM_PROXY_TARGET=http://127.0.0.1:8788
OPENMAIC_PROXY_TARGET=http://127.0.0.1:3100

# Only needed when the local classroom service requires its development key.
# Never put a production credential in this handoff package.
CLASSROOM_TEACHER_API_KEY=

# Browser-visible runtime paths. Keep same-origin paths when using the proxy above.
VITE_CLASSROOM_API_URL=/classroom-api
VITE_TEACHER_SESSION_URL=/api/teacher/session
VITE_OPENMAIC_URL=/openmaic
VITE_STUDENT_ENTRY_URL=http://leon.local.yungu-inc.org:5180/adaptive-learning/student
VITE_FAMILY_PUBLIC_BASE_URL=
