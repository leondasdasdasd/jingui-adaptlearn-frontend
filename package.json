{
  "name": "jingui-adaptlearn-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "lint": "node -e \"process.exit(0)\"",
    "clean": "rm -rf dist server.js",
    "test": "vitest run",
    "duplication:scan": "jscpd src --format javascript,typescript --min-lines 3 --min-tokens 25 --mode weak --reporters console,json --output .jscpd --gitignore --exitCode 0 --ignore '**/*.test.js,**/*.test.jsx,**/*.test.ts,**/*.test.tsx'"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@yungu-fed/question-editor": "^0.4.2",
    "fabric": "^5.5.2",
    "katex": "^0.16.45",
    "lucide-react": "^0.546.0",
    "prop-types": "^15.8.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^5.3.4",
    "slate": "^0.100.0",
    "slate-history": "^0.100.0",
    "slate-react": "^0.99.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "jscpd": "^3.5.10",
    "jsdom": "^30.0.1",
    "react-test-renderer": "^19.2.8",
    "vitest": "^3.2.4"
  }
}
